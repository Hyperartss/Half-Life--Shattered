// Generated by tools/export_viewmodel_anims.py from models/weapons/v_portalgun.mdl
// Compiles to models/sl_animtest/v_portalgun.mdl, not to models/weapons/v_portalgun.mdl
// Import in Blender with Blender Source Tools
// (File > Import > Source Engine QC) for the rig plus one action per sequence.
$modelname "sl_animtest/v_portalgun.mdl"
$model "v_portalgun" "anims/ref.smd"

$sequence "idle" "anims/idle.smd" fps 30 ACT_VM_IDLE 1 loop
$sequence "fire1" "anims/fire1.smd" fps 30 ACT_VM_PRIMARYATTACK 1
$sequence "fizzle" "anims/fizzle.smd" fps 30 ACT_VM_FIZZLE 1
$sequence "draw" "anims/draw.smd" fps 30 ACT_VM_DRAW 1
$sequence "holster" "anims/holster.smd" fps 30 ACT_VM_HOLSTER 1
$sequence "idletolow" "anims/idletolow.smd" fps 30 ACT_VM_LOWERED_TO_IDLE 1
$sequence "lowtoidle" "anims/lowtoidle.smd" fps 30 ACT_VM_IDLE_TO_LOWERED 1
$sequence "lowidle" "anims/lowidle.smd" fps 30 ACT_VM_IDLE_LOWERED 1 loop
$sequence "pickup" "anims/pickup.smd" fps 30 ACT_VM_PICKUP 1
$sequence "release" "anims/release.smd" fps 30 ACT_VM_RELEASE 1
