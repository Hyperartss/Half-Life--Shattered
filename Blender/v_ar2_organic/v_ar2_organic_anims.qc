// Generated by tools/export_viewmodel_anims.py from models/weapons/v_ar2_organic.mdl
// Compiles to models/sl_animtest/v_ar2_organic.mdl, not to models/weapons/v_ar2_organic.mdl
// Import in Blender with Blender Source Tools
// (File > Import > Source Engine QC) for the rig plus one action per sequence.
$modelname "sl_animtest/v_ar2_organic.mdl"
$cdmaterials "models/weapons/v_ar2_organic/"
$cdmaterials "models/weapons/v_wrench/"
$model "v_ar2_organic" "anims/ref.smd"

$sequence "IR_idle" "anims/IR_idle.smd" fps 30 ACT_VM_IDLE 1 loop
$sequence "IR_fire" "anims/IR_fire.smd" fps 30 ACT_VM_PRIMARYATTACK 1
$sequence "fire2" "anims/fire2.smd" fps 30 ACT_VM_RECOIL1 1
$sequence "fire3" "anims/fire3.smd" fps 30 ACT_VM_RECOIL2 1
$sequence "fire4" "anims/fire4.smd" fps 30 ACT_VM_RECOIL3 1
$sequence "IR_fire2" "anims/IR_fire2.smd" fps 30 ACT_VM_SECONDARYATTACK 1
$sequence "IR_reload" "anims/IR_reload.smd" fps 30 ACT_VM_RELOAD 1
$sequence "IR_draw" "anims/IR_draw.smd" fps 30 ACT_VM_DRAW 1
$sequence "IR_holster" "anims/IR_holster.smd" fps 30 ACT_VM_HOLSTER 1
$sequence "idletolow" "anims/idletolow.smd" fps 30 ACT_VM_LOWERED_TO_IDLE 1
$sequence "lowtoidle" "anims/lowtoidle.smd" fps 30 ACT_VM_IDLE_TO_LOWERED 1
$sequence "lowidle" "anims/lowidle.smd" fps 30 ACT_VM_IDLE_LOWERED 1 loop
$sequence "shake" "anims/shake.smd" fps 30 ACT_VM_FIDGET 1 loop
$sequence "VentPoses" "anims/VentPoses.smd" fps 30
