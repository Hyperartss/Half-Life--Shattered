// Generated by tools/export_viewmodel_anims.py from models/weapons/v_wrench.mdl
// Compiles to models/sl_animtest/v_wrench.mdl, not to models/weapons/v_wrench.mdl
// Import in Blender with Blender Source Tools
// (File > Import > Source Engine QC) for the rig plus one action per sequence.
$modelname "sl_animtest/v_wrench.mdl"
$cdmaterials "models/weapons/v_wrench/"
$model "v_wrench" "anims/ref.smd"

$sequence "idle01" "anims/idle01.smd" fps 30 ACT_VM_IDLE 1 loop
$sequence "draw" "anims/draw.smd" fps 30 ACT_VM_DRAW 1
$sequence "misscenter1" "anims/misscenter1.smd" fps 30 ACT_VM_MISSCENTER 1
$sequence "misscenter2" "anims/misscenter2.smd" fps 30 ACT_VM_MISSCENTER 1
$sequence "hitcenter1" "anims/hitcenter1.smd" fps 30 ACT_VM_HITCENTER 1
$sequence "hitcenter2" "anims/hitcenter2.smd" fps 30 ACT_VM_HITCENTER 1
$sequence "hitcenter3" "anims/hitcenter3.smd" fps 30 ACT_VM_HITCENTER 1
$sequence "hitkill1" "anims/hitkill1.smd" fps 30 ACT_VM_HITKILL 1
$sequence "holster" "anims/holster.smd" fps 30 ACT_VM_HOLSTER 1
