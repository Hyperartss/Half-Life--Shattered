// Shattered Life - wrench viewmodel
// Arms: Adrian Shephard (HECU) right arm, posed onto the HL2 crowbar viewmodel skeleton.
// Animations come from the crowbar viewmodel via $includemodel.
$modelname "weapons/v_wrench.mdl"
$cdmaterials "models/weapons/v_wrench/"
$surfaceprop "metal"
$model "wrench" "v_wrench_ref.smd"
$sequence "ref" "v_wrench_ref.smd" fps 1
$includemodel "weapons/v_crowbar.mdl"
